# DawaReminder Environment Configuration Template
# Separate .env files exist in backend/.env and frontend/.env

# === BACKEND (Render / Local) ===
ENVIRONMENT=development
PORT=8000
DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_host>/<neon_db>?ssl=require
SESSION_SECRET=replace_with_secure_random_string_min_32_chars
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,https://dawareminder.vercel.app

# === FRONTEND (Vercel / Local) ===
VITE_API_BASE_URL=/api
