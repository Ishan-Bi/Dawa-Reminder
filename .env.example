# DawaReminder Environment Configuration
ENVIRONMENT=development
APP_NAME="DawaReminder"
APP_VERSION="1.0.0"

# Application Security
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dawa_secure_pass
POSTGRES_DB=dawareminder_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:dawa_secure_pass@localhost:5432/dawareminder_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# S3 Compatible Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dawa_minio_admin
S3_SECRET_KEY=dawa_minio_secret_key_123
S3_BUCKET_NAME=dawareminder-vault
S3_REGION=ap-south-1

# Web Push Notification Keys (VAPID)
VAPID_PUBLIC_KEY=generate_vapid_keys_before_production
VAPID_PRIVATE_KEY=generate_vapid_keys_before_production
VAPID_CLAIM_EMAIL=mailto:admin@dawareminder.in

# Frontend API URL
VITE_API_BASE_URL=http://localhost/api/v1
