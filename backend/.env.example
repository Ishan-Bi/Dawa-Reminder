# DawaReminder - Backend Environment Variables
ENVIRONMENT=development
PORT=8000

# Database
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?ssl=require
# Local fallback (SQLite for instant local dev, or local Postgres):
DATABASE_URL=sqlite+aiosqlite:///./dawareminder.db

# Caregiver Auth & Session Secret
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars_1234567890

# Cloudinary Configuration for Medicine Photos
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS / Origin Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
